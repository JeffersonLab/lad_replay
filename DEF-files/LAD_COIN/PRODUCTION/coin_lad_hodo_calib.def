# LAD hodoscope calibration output (time walk, bar offsets, edep): per-PMT TDC/FADC arrays,
# the per-plane hit lists and good hits, the LAD-crate trigger/photodiode TDCs, and the
# spectrometer quantities needed for the electron time. No GEM, no FADC waveforms.
block g.*
block T.shms.*LAD*
block T.hms.*LAD*
block T.shms.pRF_tdc*
block T.hms.hRF_tdc*

block P.ladhod.*Tdc*
block P.ladhod.*AdcPulse*
block P.ladhod.*AdcPed*
block P.ladhod.*AdcCounter
block P.ladhod.*AdcErrorFlag
block P.ladhod.*AdcMult
block P.ladhod.*HodoHit*
block P.ladhod.*Good*
block P.ladhod.goodhit_*
block P.ladkin.*
block H.ladhod.*Tdc*
block H.ladhod.*AdcPulse*
block H.ladhod.*AdcPed*
block H.ladhod.*AdcCounter
block H.ladhod.*AdcErrorFlag
block H.ladhod.*AdcMult
block H.ladhod.*HodoHit*
block H.ladhod.*Good*
block H.ladhod.goodhit_*
block H.ladkin.*

block P.hod.*time
block P.hod.*Time
block P.gtr.*
block P.kin.*
block P.cal.e*
block P.hgcer.npe*
block P.react.*
block H.hod.*time
block H.hod.*Time
block H.gtr.*
block H.kin.*
block H.cal.e*
block H.cer.npe*
block H.react.*
